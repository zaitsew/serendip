# add-product.sh copies this to /srv/serendip/.env (mode 600) on the first run. Fill the values in on the
# server, never in the repo. Only SERENDIP_OWNER_KEY is required.

# The one key that gates every page, API route and MCP call. Generate one: openssl rand -hex 24
SERENDIP_OWNER_KEY=

# TMDB v4 "API Read Access Token" (free). Without it Serendip runs on the labelled sample catalog.
TMDB_READ_TOKEN=

# YouTube Data API v3 key (free, 10,000 units a day). Unlocks topic clusters and real Detour videos.
YOUTUBE_API_KEY=

# Google OAuth client ID ("Web application") for the optional private "Serendip Detour" playlist.
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth client secret. Register https://serendip.fabriquefutur.com/api/youtube/callback as the redirect URI.
GOOGLE_OAUTH_CLIENT_SECRET=
