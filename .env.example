# Copy this to .env. ./check.sh requires only SERENDIP_OWNER_KEY.

# The one key that gates every page and API route. Generate one: openssl rand -hex 24
SERENDIP_OWNER_KEY=

# TMDB v4 "API Read Access Token" (free): themoviedb.org -> Settings -> API. See docs/GETTING-STARTED.md.
# Without it Serendip runs on a labelled sample catalog of 32 films.
TMDB_READ_TOKEN=

# YouTube Data API v3 key (free, 10,000 quota units a day). Unlocks topic clusters from your Takeout history
# and the Detour channel (real videos). Without it Detour shows six labelled sample cards and clusters by
# channel only. Steps: docs/GETTING-STARTED.md, step 5.
YOUTUBE_API_KEY=

# Optional: Google OAuth client ("Web application") so Serendip can keep a private "Serendip Detour" playlist
# in your YouTube account and you can play it in the TV's YouTube app. Needs both values. Steps: step 6.
# Register http://localhost:3000/api/youtube/callback for dev (press Connect from the Mac's own browser, because
# Google refuses LAN IP addresses), and <SERENDIP_PUBLIC_URL>/api/youtube/callback in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Overrides the redirect URI that is otherwise derived: SERENDIP_PUBLIC_URL + /api/youtube/callback, or localhost.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# SQLite file. Default ./data/serendip.db
# SERENDIP_DB=./data/serendip.db

# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For.
# SERENDIP_TRUST_PROXY=1

# The public address when deployed (no trailing slash). Redirects and the Google OAuth redirect URI use it.
# SERENDIP_PUBLIC_URL=https://serendip.fabriquefutur.com

# Set to 1 when the site is served over https (marks the session cookie Secure).
# The TV opens plain http://<mac-ip>:3000, so leave it off for that.
# SERENDIP_SECURE_COOKIE=1
